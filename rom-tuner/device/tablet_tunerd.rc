on property:sys.boot_completed=1
    start tablet_tunerd

service tablet_tunerd /system/bin/sh /system/bin/tablet_tunerd.sh
    user root
    group root
    seclabel u:r:su:s0
    disabled

# A reboot or shutdown the system asked for is not a crash: drop the overclock marker so the profile (overclock included) comes back after the next boot.
# A panic, watchdog reset or power loss does not run this, so the marker stays and the daemon still reverts the overclock after a boot that died while overclocked.
on shutdown
    exec u:r:su:s0 root root -- /system/bin/rm -f /data/local/tmp/oc_pending
