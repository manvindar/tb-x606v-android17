# Storage tuning from PerfMTK (eMMC): the stock 1 MB read-ahead hurts foreground latency when background I/O runs.
# Vendor init (mtkpower init rc) rewrites these during boot, so apply once boot has completed.
on property:sys.boot_completed=1
    write /sys/block/mmcblk0/queue/read_ahead_kb 256
    write /sys/block/mmcblk0/queue/nr_requests 64
